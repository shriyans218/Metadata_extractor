# Pick ONE provider: nvidia | gemini | groq | anthropic | openai | openrouter
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your_key_here
# Default model per provider is set in app/extraction/extractor.py; override with LLM_MODEL.
# nvidia default: moonshotai/kimi-k2.6 (alternatives: nvidia/nemotron-3-ultra-550b-a55b, meta/llama-3.3-70b-instruct)

# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_key_here          # default model gemini-2.5-flash

# LLM_PROVIDER=groq
# GROQ_API_KEY=your_key_here            # default model openai/gpt-oss-120b

# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your_key_here       # default model claude-sonnet-5-5 (paid credits)

# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_key_here

# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=your_key_here

# Optional override:
# LLM_MODEL=
# Optional, if Tesseract is not on PATH:
# TESSERACT_CMD=
